@Library('jenkins-shared-library') _

node {
    stage('Checkout') {
        checkout scm
    }

    def services = [
        'auth-service',
        'cart-service',
        'catalog-service',
        'order-service',
        'notification-service'
    ]

    def changedFiles = sh(
        script: "git diff --name-only HEAD~1 HEAD || git diff --name-only \$(git rev-list --max-parents=0 HEAD) HEAD",
        returnStdout: true
    ).trim().split('\n')

    def frontendChanged = false
    def changedService = null

    for (f in changedFiles) {
        if (f.startsWith('frontend/')) {
            frontendChanged = true
            break
        }
    }

    if (!frontendChanged) {
        for (f in changedFiles) {
            for (svc in services) {
                if (f.startsWith("services/${svc}/")) {
                    changedService = svc
                    break
                }
            }
            if (changedService) break
        }
    }

    echo "Frontend changed: ${frontendChanged}"
    echo "Service changed: ${changedService}"

    if (frontendChanged) {
        frontendPipeline(
            gitRepoName: 'nimbs-platform',
            gitUserName: 'hansonjohnny'
        )
    } else if (changedService) {
        fullPipeline(
            service:          changedService,
            appDir:           "services/${changedService}",
            k8sDir:           "k8s/${changedService}",
            sonarProjectKey:  "cloud-native-${changedService}",
            sonarProjectName: "cloud-native-${changedService}",
            ecrCredId:        "ECR_REPO_${changedService.toUpperCase().replace('-','_')}",
            gitRepoName:      'nimb-platform',
            gitUserName:      'hansonjohnny'
        )
    } else {
        echo "No changes detected in any service or frontend, skipping."
    }
}